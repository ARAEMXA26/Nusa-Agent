{
  "schemaVersion": 1,
  "id": "multi-agent-orchestration",
  "name": "Multi-Agent Orchestration",
  "version": "1.0.0",
  "description": "Mendelegasikan subtask independen, menyatukan hasil, mengelola status dan konflik.",
  "tags": [
    "agents",
    "delegation",
    "parallel"
  ],
  "scope": "bundled",
  "entrypoint": "SKILL.md",
  "enabledByDefault": true,
  "tools": [
    "agent_spawn",
    "agent_message",
    "agent_wait",
    "agent_stop"
  ],
  "optionalTools": [],
  "dependencies": {
    "commands": [],
    "runtimes": [],
    "plugins": [],
    "environmentVariables": []
  },
  "permissions": {
    "filesystem": "read",
    "network": "none",
    "shell": "none",
    "computerControl": "none"
  },
  "riskLevel": "medium",
  "requiresApprovalFor": [
    "agent_spawn_exceeding_budget"
  ],
  "compatibility": {
    "os": [
      "darwin",
      "linux",
      "win32"
