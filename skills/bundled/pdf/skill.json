    "shell": "none",
    "computerControl": "none"
  },
  "riskLevel": "medium",
  "requiresApprovalFor": [],
  "compatibility": {
    "os": [
      "darwin",
      "linux",
      "win32"
    ],
    "minAppVersion": "0.1.0"
  }
