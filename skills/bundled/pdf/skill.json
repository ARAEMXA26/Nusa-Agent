{
  "schemaVersion": 1,
  "id": "pdf",
  "name": "PDF Studio",
  "version": "1.0.0",
  "description": "Membaca, membuat, menggabungkan, mengisi, merender, dan memeriksa PDF.",
  "tags": [
    "pdf",
    "forms",
    "render"
  ],
  "scope": "bundled",
  "entrypoint": "SKILL.md",
